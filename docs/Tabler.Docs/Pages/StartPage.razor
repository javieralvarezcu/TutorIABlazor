@code {
    private User userData = new();
    private List<StudentSkill> skills = new();



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            var userId = await _localStorage.GetItemAsync<int?>("profile") ?? 0;

            userData = _authService.GetUserById(userId);
            skills = await _datasetService.GetStudentSkillByUserIdAsync(userId);
            await _localStorage.SetItemAsync("skills", skills);
            StateHasChanged();
        }

        // var studentStateRoaster = await _datasetService.GetStudentStateRoasterById(userId);

        // StateHasChanged();
    }
}

